# SAFIR - ortam degiskenleri ornegi
# Bu dosyayi ".env" olarak kopyalayip degerleri doldurun. ".env" repoya EKLENMEZ.

# SAFIR IKI saglayici kullanir: model/anlama katmani GEMINI, guvenlik katmani GROQ.
# Bu bilincli bir izolasyondur - bir saglayicida kota/kesinti olursa digeri ayakta kalir.

# --- 1) Google Gemini (configs/config.yaml -> vlm / llm / memory.embedding) ---
#   - VLM (video)                  : native  https://generativelanguage.googleapis.com/v1beta/models/<model>:generateContent
#   - VLM (kare) / LLM / embedding : OpenAI-uyumlu https://generativelanguage.googleapis.com/v1beta/openai
# Anahtari https://aistudio.google.com/apikey adresinden alabilirsiniz.
#
# Bu dosyayi ".env" olarak kopyalayip degerleri doldurabilir VEYA anahtarlari
# dogrudan terminalde tanimlayabilirsiniz:
#   PowerShell : $env:GEMINI_API_KEY = "..."
#   bash/zsh   : export GEMINI_API_KEY="..."
GEMINI_API_KEY=

# --- 2) Groq (configs/config.yaml -> guard) ---
# Prompt-injection guard: OpenAI-uyumlu https://api.groq.com/openai/v1
# Anahtari https://console.groq.com/keys adresinden alabilirsiniz.
#   PowerShell : $env:GROQ_API_KEY = "..."
#   bash/zsh   : export GROQ_API_KEY="..."
#
# ONEMLI: guard `fail_closed: true` ile calisir - bu anahtar TANIMSIZSA her
# analizde VLM aciklamasi/kullanici istemi QUARANTINE olarak isaretlenir
# (icerik gizlenmez ama gorunur sekilde damgalanir). Guard'i gecici olarak
# kapatmak icin configs/config.yaml -> guard.enabled: false.
GROQ_API_KEY=

# NOT: RAG embedding katmani neden Groq'ta DEGIL? Groq'un model katalogunda
# hicbir embedding modeli yoktur (yalnizca metin uretimi, Whisper, TTS ve
# prompt-guard siniflandiricilari). Bu yuzden embedding Gemini'de kalir.

# RAG vektor deposu: ayri bir sunucu GEREKMEZ - Qdrant, `data/qdrant` altinda
# YEREL/gomulu (disk-tabanli) olarak calisir (bkz. configs/config.yaml ->
# memory.qdrant.url). Bu katman icin HICBIR ortam degiskeni gerekmez.

# --- DEVRE DISI: TEKNOFEST EVREN yarisma servisi ---
# EVREN takima KAPATILDI; saglayici kodu repoda korunuyor ama config bunlari
# artik SECMIYOR. Yeniden acilirsa asagidakileri doldurup configs/config.yaml
# icindeki provider degerlerini "evren"e cevirmek yeterlidir.
# EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
# EVREN_API_KEY=
# EVREN_TEAM=
# EVREN_QDRANT_URL=https://evren-vektor.ssyz.org.tr
# EVREN_QDRANT_KEY=

# Operator panelinin backend adresi (varsayilan: http://localhost:8000)
# SAFIR_API_URL=http://localhost:8000
