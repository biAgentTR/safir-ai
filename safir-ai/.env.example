# SAFIR - ortam degiskenleri ornegi
# Bu dosyayi ".env" olarak kopyalayip degerleri doldurun. ".env" repoya EKLENMEZ.

# --- Gemini TEST backend'i (yalnizca gelistirme/test) ---
# VRAM yetersizliginde yerel VLM/LLM yerine Gemini ile test etmek icin:
#   1) configs/config.yaml -> vlm.active_model: "gemini", llm.active_model: "gemini"
#   2) Asagidaki anahtari doldurun (https://aistudio.google.com/apikey)
# UYARI: Harici API, sartnamenin offline gereksinimini ihlal eder; teslimde yerel modele donun.
GEMINI_API_KEY=

# Operator panelinin backend adresi (varsayilan: http://localhost:8000)
# SAFIR_API_URL=http://localhost:8000
