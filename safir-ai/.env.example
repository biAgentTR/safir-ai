# SAFIR - ortam degiskenleri ornegi
# Bu dosyayi ".env" olarak kopyalayip degerleri doldurun. ".env" repoya EKLENMEZ.

# --- TEKNOFEST EVREN yarisma cikarim servisi (configs/config.yaml -> vlm/llm/memory "evren") ---
# Tek aktif VLM/LLM/embedding/rerank saglayicisi: video DOGRUDAN EVREN'in
# video-analiz ucuna gonderilir (yerel GPU/vLLM gerekmez). Anahtar takima
# ozel e-posta ile iletilir.
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_API_KEY=
EVREN_TEAM=

# RAG vektor deposu: takima tahsis edilmis izole Qdrant orneği (dokumantasyon SS 11).
EVREN_QDRANT_URL=https://evren-vektor.ssyz.org.tr
EVREN_QDRANT_KEY=

# Operator panelinin backend adresi (varsayilan: http://localhost:8000)
# SAFIR_API_URL=http://localhost:8000
