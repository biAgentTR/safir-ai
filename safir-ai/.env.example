# =============================================================================
# SAFİR AI — Ortam Değişkenleri ve Yapılandırma Şablonu (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. VLM (Vision-Language Model) Sağlayıcı Ayarları
# -----------------------------------------------------------------------------
# Seçenekler: gemini (geliştirme/test) | vllm (yerel üretim sunucusu) | mock (birim test)
VLM_PROVIDER=gemini

# Geliştirme Amaçlı Gemini API Key (VLM_PROVIDER=gemini iken kullanılır)
GEMINI_API_KEY=your_gemini_api_key_here

# Yerel vLLM Sunucusu Ayarları (VLM_PROVIDER=vllm iken kullanılır)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL_NAME=Qwen/Qwen2-VL-7B-Instruct

# -----------------------------------------------------------------------------
# 2. LLM Karar Ajani ve Muhakeme Motoru (LangGraph)
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-2.5-flash

# -----------------------------------------------------------------------------
# 3. Hibrit RAG Arama Ağırlıkları (FAISS + BM25)
# -----------------------------------------------------------------------------
FAISS_WEIGHT=0.5
BM25_WEIGHT=0.5
RAG_TOP_K=5

# -----------------------------------------------------------------------------
# 4. Otomatik Eskalasyon ve Saha Alarm Eşikleri
# -----------------------------------------------------------------------------
NOTIFY_THRESHOLD=26
ALERT_THRESHOLD=51
ALERT_ENDPOINT=http://localhost:8000/alerts/trigger

# -----------------------------------------------------------------------------
# 5. CPU Adaptive Frame Sampler Ayarları
# -----------------------------------------------------------------------------
MIN_CHANGE_THRESHOLD=0.001
SAMPLE_FPS=5.0
MAX_SAMPLING_GAP_SEC=4.0
REF_CHANGE_THRESHOLD=0.0015
CONTRAST_CHECK_INTERVAL_SEC=1.0

# -----------------------------------------------------------------------------
# 6. Uygulama ve Günlükleme
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
